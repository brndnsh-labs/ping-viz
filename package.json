{
  "name": "ping-viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check src tests scripts vite.config.ts",
    "lint:fix": "biome check --write src tests scripts vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/shot.ts",
    "smoke": "node scripts/smoke.ts",
    "land": "node scripts/land.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
